    ["var(--theme-white)",false,"The computer terminal has evolved from humble beginnings in the"],
    [null,false," "],
    ["var(--theme-yellow)",true,"1960s"],
    ["var(--theme-white)",false,"."],
    [null,false,"\n"],
    ["var(--theme-white)",false,"Originally, terminals were physical devices -- teletypewriters that"],
    [null,false,"\n"],
    ["var(--theme-white)",false,"allowed users to interact with mainframe computers through typed commands."],
    [null,false,"\n\n"],
    ["var(--theme-white)",false,"The first video terminals appeared in the"],
    [null,false," "],
    ["var(--theme-yellow)",true,"1970s"],
    ["var(--theme-white)",false," replacing paper printouts"],
    [null,false,"\n"],
    ["var(--theme-white)",false,"with cathode-ray tube displays. Then, with the rise of personal computers"],
    [null,false,"\n"],
    ["var(--theme-white)",false,"in the"],
    [null,false," "],
    ["var(--theme-yellow)",true,"1980s"],
    ["var(--theme-white)",false,", terminal emulators brought command-line interfaces to"],
    [null,false,"\n"],
    ["var(--theme-white)",false,"graphical environments."],
    [null,false," "],
    ["var(--theme-bright-green)",true,"Unix"],
    [null,false," "],
    ["var(--theme-white)",false,"systems"],
    [null,false," popularised shells like "],
    ["var(--theme-bright-cyan)",true,"sh"],
    ["var(--theme-white)",false,","],
    ["var(--theme-bright-cyan)",true," csh"],
    ["var(--theme-white)",false,", and"],
    [null,false,"\n"],
    ["var(--theme-white)",false,"later "],
    ["var(--theme-bright-cyan)",true,"bash"],
    ["var(--theme-white)",false,", making terminals powerful tools for system administration and\ndevelopment.\n\nToday's terminals blend their classic functionality with modern features\n-- syntax highlighting, tabs, themes, and web-based implementations like\nthis one. Despite decades of GUI evolution, the terminal remains an\nessential tool for developers, system admins, and power users worldwide.\n\nThe command line endures because text is universal, scriptable, and\nefficient, proving that sometimes the oldest interfaces are the most \n"],
    ["var(--theme-bright-green)",true,"timeless"],
    ["var(--theme-white)",false,".\n\n"]
