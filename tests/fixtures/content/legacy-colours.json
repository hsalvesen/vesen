    ["var(--theme-cyan)",false,"sudo pacman -Syu"],
    [null,false,"\n"],
    ["var(--theme-green)",false,"□"],
    [null,false," Install essential packages: "],
    ["var(--theme-cyan)",false,"sudo pacman -S vim git htop neofetch"],
    [null,false,"\n"],
    ["var(--theme-green)",false,"□"],
    [null,false," Configure .bashrc with aliases and PS1 customization\n"],
    ["var(--theme-green)",false,"□"],
    [null,false," Install and configure zsh with oh-my-zsh\n"],
