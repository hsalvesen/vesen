# Copy to .env.local (ignored by git) and fill in what you need. Vite reads it at build time.

# The stock Worker's base URL (worker/stock), with no trailing slash, such as
# https://vesen-stock.<your-subdomain>.workers.dev. Leave it empty until the Worker is deployed:
# `stock` then uses its interim source, Yahoo Finance through the public api.allorigins.win proxy,
# which is slower and says so on every card. CI builds read the VITE_STOCK_API repository variable.
VITE_STOCK_API=

# vesen's own fetch proxy for `curl --via-proxy` (an https URL such as https://proxy.example/fetch).
# Leave it empty while the site has none: curl --via-proxy then says so. CI builds read the
# VITE_FETCH_PROXY repository variable.
VITE_FETCH_PROXY=
