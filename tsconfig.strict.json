{
  // Strict checking for the browser code written during the overhaul, from day one.
  // The legacy code (src/utils, src/components, src/interfaces) stays under tsconfig.json
  // until it is ported. Globs that match nothing yet are fine.
  //
  // No ambient types: Node's would let `process`, `Buffer` and Array.prototype.at (which
  // @types/node adds to ES2021) through, and Safari 15 has none of them. vite/client and svelte
  // come in through src/global.d.ts. Tests, scripts and config files are checked under Node's
  // types by tsconfig.strict.node.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "checkJs": true,
    "types": []
  },
  "include": [
    "src/global.d.ts",
    "src/app/**/*.ts",
    "src/shell/**/*.ts",
    "src/output/**/*.ts",
    "src/vfs/**/*.ts",
    "src/lib/**/*.ts",
    "src/services/**/*.ts",
    "src/platform/**/*.ts",
    "src/ui/**/*.ts",
    "src/commands/**/*.ts",
    "src/stores/**/*.ts",
    "src/constants.ts",
    "src/utils/beep.ts",
    "worker/**/*.ts"
  ],
  "exclude": ["**/node_modules", "dist", "**/*.test.ts"]
}
