{
  // Strict checking for the browser code, which `npm run check:strict` runs with tsc. Svelte
  // components are checked by svelte-check under tsconfig.json.
  //
  // No ambient types: Node's would let `process`, `Buffer` and Array.prototype.at (which
  // @types/node adds to ES2021) through, and Safari 15 has none of them. vite/client and svelte
  // come in through src/global.d.ts. Tests, scripts and config files are checked under Node's
  // types by tsconfig.strict.node.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "checkJs": true,
    "types": []
  },
  "include": [
    "src/global.d.ts",
    "src/app/**/*.ts",
    "src/shell/**/*.ts",
    "src/output/**/*.ts",
    "src/vfs/**/*.ts",
    "src/lib/**/*.ts",
    "src/services/**/*.ts",
    "src/platform/**/*.ts",
    "src/ui/**/*.ts",
    "src/commands/**/*.ts",
    "src/stores/**/*.ts",
    "src/interfaces/**/*.ts",
    "worker/**/*.ts"
  ],
  // The Worker's test helpers read fixtures with Node, so they are checked by
  // tsconfig.strict.node.json.
  "exclude": ["**/node_modules", "dist", "**/*.test.ts", "worker/*/test/**"]
}
