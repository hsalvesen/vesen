{
  // The strict settings of tsconfig.strict.json for code that runs under Node or Vitest:
  // the unit tests of the strict folders, the test helpers, scripts and config files.
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "src/global.d.ts",
    "src/app/**/*.test.ts",
    "src/shell/**/*.test.ts",
    "src/output/**/*.test.ts",
    "src/vfs/**/*.test.ts",
    "src/lib/**/*.test.ts",
    "src/services/**/*.test.ts",
    "src/platform/**/*.test.ts",
    "src/ui/**/*.test.ts",
    "src/commands/**/*.test.ts",
    "src/stores/**/*.test.ts",
    "src/testing/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "tests/hosting/**/*.ts",
    "tests/harness.ts",
    "tests/transcripts/**/*.ts",
    "tests/support/**/*.ts",
    "tests/security/**/*.ts",
    "e2e/**/*.ts",
    "worker/*/test/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["**/node_modules", "dist"]
}
